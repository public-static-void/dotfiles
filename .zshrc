# Ksp.
alias ksp="cd $HOME/.wine/drive_c/Program\ Files\ \(x86\)/Kerbal\ Space\ Program\ Breaking\ Ground; wine-64 WINEDEBUG=-all wine Launcher.exe"

# Subsistence.
