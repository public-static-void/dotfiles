############
# ~/.zshrc #
############

####################
# GENERAL SETTINGS #
####################

# If not running interactively, dont do anything.
[[ $- != *i* ]] && return

# Disable terminal freezing from Ctrl-S.
stty -ixon

# Source colors generated by pywal.
#(cat ~/.cache/wal/sequences &)
#source ~/.cache/wal/colors-tty.sh

# Allow to change directory without typing "cd".
setopt autocd

# Disable bell.
setopt nobeep

# History settings.
HISTFILE=~/.histfile
HISTSIZE=10000
SAVEHIST=10000
setopt INC_APPEND_HISTORY SHARE_HISTORY

# Enable vi-mode.
bindkey -v
export KEYTIMEOUT=1

#########################
# ENVIRONMENT VARIABLES #
#########################

# Initialize PATH array with unique entries
typeset -U PATH path
path=()

# Core system paths (essential utilities first)
path=(
  /usr/bin
  /bin
  /usr/local/bin
  /usr/sbin
  /sbin
  ${path}
)

# Load NVM early but after system paths
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" 2>/dev/null

# Node.js paths (only if NVM loaded successfully)
if command -v nvm &>/dev/null; then
  path=(
    "$NVM_DIR/versions/node/$(nvm version default)/bin"
    ${path}
  )
fi

# Other tool paths
path=(
  "$HOME/.pyenv/bin"
  "$HOME/perl5/bin"
  "$HOME/.local/bin"
  "$HOME/scripts"
  "$HOME/.cargo/bin"
  "$HOME/go/bin"
  "$HOME/.config/composer/vendor/bin"
  "$HOME/.gem/ruby/*/bin"(N)
  "$HOME/.local/share/gem/ruby/3.4.0/bin"
  ${path}
)

# Angular CLI (only if npm is available)
if command -v npm &>/dev/null; then
  path+=("$(npm root -g)/@angular/cli/bin")
fi

# Perl (local::lib)
eval "$(perl -I$HOME/perl5/lib/perl5 -Mlocal::lib)" 2>/dev/null

# pyenv
export PYENV_ROOT="$HOME/.pyenv"
command -v pyenv &>/dev/null && eval "$(pyenv init --path)"
command -v pyenv &>/dev/null && eval "$(pyenv init -)"

# direnv
command -v direnv &>/dev/null && eval "$(direnv hook zsh)"

# Java
[ -d "/usr/lib/jvm/default" ] && export JAVA_HOME="/usr/lib/jvm/default"

# Exports
export PATH
# Editor and colors
if [[ -n "$SSH_CONNECTION" ]]; then
    export EDITOR="vim"
    export VISUAL="vim"
    export MANPAGER="vim -c 'set ft=man' -"
elif command -v nvim >/dev/null 2>&1; then
    export EDITOR="nvim"
    export VISUAL="nvim"
    export MANPAGER="nvim +Man!"
else
    export EDITOR="vim"
    export VISUAL="vim"
    export MANPAGER="vim -c 'set ft=man' -"
fi
export LS_COLORS="${LS_COLORS}:di=0;36:"

#############
# AUTOSTART #
#############

# Start fastfetch with terminal.
fastfetch --logo-color-2 "22"

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
[[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]] && source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"

# Enable colors.
autoload -U colors && colors

# Enable completion.
zmodload zsh/complist
autoload -Uz compinit && compinit

#######################
# COMPLETION SETTINGS #
#######################

# Include hidden files and set completion options.
_comp_options+=(globdots)
setopt MENU_COMPLETE
setopt COMPLETE_IN_WORD

# Prevent aliases from being internally substituted before completion.
#setopt COMPLETE_ALIASES

# Define completers and enable menu selection.
zstyle ':completion:*' completer _extensions _complete _approximate
zstyle ':completion:*' menu select

# Configure approximate completion settings.
zstyle -e ':completion:*:approximate:*' max-errors 'reply=( $(( ($#PREFIX + $#SUFFIX) / 5 )) )'

# Autocomplete options for cd instead of directory stack.
zstyle ':completion:*' complete-options true
zstyle ':completion:*' file-sort modification

# Format output for various completion messages.
zstyle ':completion:*:*:*:*:corrections' format '%F{yellow}!- %d (errors: %e) -!%f'
zstyle ':completion:*:*:*:*:descriptions' format '%F{blue}-- %D %d --%f'
zstyle ':completion:*:*:*:*:messages' format ' %F{purple} -- %d --%f'
zstyle ':completion:*:*:*:*:warnings' format ' %F{red}-- no matches found --%f'

# Colors for files and directories.
zstyle ':completion:*:*:*:*:default' list-colors ${(s.:.)LS_COLORS}

# Tag order for cd command completion.
zstyle ':completion:*:*:cd:*' tag-order local-directories directory-stack path-directories

# Grouping completions by type.
zstyle ':completion:*' group-name ''
zstyle ':completion:*:*:-command-:*:*' group-order aliases builtins functions commands

# Case insensitive matching and prefix handling.
zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' keep-prefix true

# Enable autocompletion in sudo mode.
zstyle ":completion::complete:*" gain-privileges 1

# Enable command and folder completion when line is empty.
blanktab() {
  if [[ $#BUFFER == 0 ]]; then
    CURSOR=3
    zle list-choices
  else
    zle expand-or-complete
  fi
}

# Register the blanktab function and bind it to the Tab key.
zle -N blanktab
bindkey "^I" blanktab

###################
# PROMPT SETTINGS #
###################

# Git integration.
autoload -Uz vcs_info
precmd_vcs_info() { vcs_info }
precmd_functions+=( precmd_vcs_info )

# Enable prompt substitution and set the prompt format.
setopt prompt_subst
PROMPT='%F{red}%n@%m:%F{cyan}%2~%f${vcs_info_msg_0_}%# '

# Configure vcs_info for Git status display.
zstyle ':vcs_info:*' check-for-changes true
zstyle ':vcs_info:*' unstagedstr ' *'
zstyle ':vcs_info:*' stagedstr ' +'
zstyle ':vcs_info:git:*' formats '(%b%u%c)'
zstyle ':vcs_info:git:*' actionformats '(%b|%a%u%c)'

# Function to set the beam shape cursor.
set_beam_cursor() {
  echo -ne "\e[5 q"
}

# Change cursor shape based on vi modes.
zle-keymap-select() {
  case ${KEYMAP} in
    vicmd)
      # Block cursor for command mode
      echo -ne "\e[1 q" ;;
    main|viins|"")
      # Beam cursor for insert and main modes
      set_beam_cursor ;;
  esac
}

# Initialize keymap and set cursor shape on line initialization.
zle-line-init() {
  # Set vi insert mode as keymap.
  zle -K viins
  set_beam_cursor
}

# Register ZLE functions.
zle -N zle-keymap-select
zle -N zle-line-init

# Set beam shape cursor on startup and for each new prompt.
set_beam_cursor
preexec() { set_beam_cursor; }

###############
# KEYBINDINGS #
###############

# Shift-tab to browse completion menu backwards.
bindkey -M menuselect '^[[Z' reverse-menu-complete

# Use vim keys in tab complete menu.
bindkey -M menuselect "h" vi-backward-char
bindkey -M menuselect "j" vi-down-line-or-history
bindkey -M menuselect "k" vi-up-line-or-history
bindkey -M menuselect "l" vi-forward-char

# Use vim mode for backward delete.
bindkey -v "^?" backward-delete-char

# Insert in completion menu.
bindkey -M menuselect '^xi' vi-insert
# Undo in completion menu.
bindkey -M menuselect '^xu' undo

# Fix broken keys for insert mode.

# Yank (Insert).
bindkey "^[[2~" yank
# Delete (Insert).
bindkey "^[[3~" delete-char
# Page Up (Insert).
bindkey "^[[5~" up-line-or-history
# Page Down (Insert).
bindkey "^[[6~" down-line-or-history
# Home (Insert).
bindkey "^[[7~" beginning-of-line
# End (Insert).
bindkey "^[[8~" end-of-line

# Fix broken keys for command mode.

# Yank (Command).
bindkey -a "^[[2~" yank
# Delete (Command).
bindkey -a "^[[3~" delete-char
# Page Up (Command).
bindkey -a "^[[5~" up-line-or-history
# Page Down (Command).
bindkey -a "^[[6~" down-line-or-history
# Home (Command).
bindkey -a "^[[7~" beginning-of-line
# End (Command).
bindkey -a "^[[8~" end-of-line

###########
# ALIASES #
###########

[[ -f $HOME/.aliases ]] && source $HOME/.aliases

#############
# FUNCTIONS #
#############

[[ -f $HOME/.functions ]] && source $HOME/.functions

###########
# PLUGINS #
###########

# Load plugins (should be last).

# Load zsh-syntax-highlighting.
if [[ -f /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
elif [[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# Load zsh-autosuggestions.
if [[ -f /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
elif [[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# Angular CLI completion (only if installed).
if command -v ng &>/dev/null; then
  source <(ng completion script)
fi

# Load Powerlevel10k prompt theme.
if [[ -f /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme ]]; then
  source /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme
elif [[ -f ~/.powerlevel10k/powerlevel10k.zsh-theme ]]; then
  source ~/.powerlevel10k/powerlevel10k.zsh-theme
fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
