############
# ~/.zshrc #
############

####################
# GENERAL SETTINGS #
####################

# If not running interactively, dont do anything.
[[ $- != *i* ]] && return

# Source colors generated by pywal.
#(cat ~/.cache/wal/sequences &)
#source ~/.cache/wal/colors-tty.sh

# Allow to change directory without typing "cd".
setopt autocd

# Disable bell.
setopt nobeep

# History settings.
HISTFILE=~/.histfile
HISTSIZE=10000
SAVEHIST=10000

# Enable vi-mode.
bindkey -v
export KEYTIMEOUT=1

#########################
# ENVIRONMENT VARIABLES #
#########################

# Keeps the entries in PATH unique (due to mirroring).
typeset -aU path

# Add custom scripts folder to PATH.
if [[ -d $HOME/scripts && -z $(echo $PATH | grep -o $HOME/scripts) ]]; then
    PATH="${PATH}:$HOME/scripts"
fi

# Set JAVA_HOME and add java 15 to PATH (for renew).
# JAVA_HOME="/usr/lib/jvm/java-15-adoptopenjdk"
# if [[ -d $JAVA_HOME/bin && -z $(echo $PATH | grep -o $JAVA_HOME/bin) ]]; then
#     PATH="${PATH}:$JAVA_HOME/bin"
# fi
# JAVA_HOME="/usr/lib/jvm/java-18-openjdk"
# if [[ -d $JAVA_HOME/bin && -z $(echo $PATH | grep -o $JAVA_HOME/bin) ]]; then
#     PATH="${PATH}:$JAVA_HOME/bin"
# fi
JAVA_HOME="/usr/lib/jvm/default"
if [[ -d $JAVA_HOME/bin && -z $(echo $PATH | grep -o $JAVA_HOME/bin) ]]; then
    PATH="${PATH}:$JAVA_HOME/bin"
fi

JDTLS_HOME="/usr/bin/jdtls"

# Set ANT_HOME and add ant to PATH (for renew).
# ANT_HOME="$HOME/UNI/MASTER/2-SoSe22/MVS/MVS2022/libs/ant"
# if [[ -d $ANT_HOME/bin && -z $(echo $PATH | grep -o $ANT_HOME/bin) ]]; then
#     PATH="${PATH}:$ANT_HOME/bin"
# fi

# Enable colors for ls.
LS_COLORS=$LS_COLORS:'di=0;36:'; export LS_COLORS

# Preferred editor for local and remote sessions.
if [[ -n $SSH_CONNECTION ]]; then
    export EDITOR="vim"
else
    export EDITOR="nvim"
fi

# Export the PATH-variable.
export PATH

#############
# AUTOSTART #
#############

# Start neofetch with terminal.
neofetch --ascii_colors 14 23

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Enable colors.
autoload -U colors && colors

# Enable completion.
zmodload zsh/complist
autoload -Uz compinit && compinit

#######################
# COMPLETION SETTINGS #
#######################
#
# Include hidden files.
_comp_options+=(globdots)

# Automatically highlight first element of completion menu.
setopt MENU_COMPLETE
# Complete from both ends of a word.
setopt COMPLETE_IN_WORD
# Prevents aliases from being internally substituted before completion.
#setopt COMPLETE_ALIASES

# _complete    -> completing
# _expand      -> expand variables
# _prefix      -> ignore everything behind cursor
# _approximate -> fuzzy completion
# _ignore      -> ignore some matches (i.e. directories when doing cd)

# Define completers.
zstyle ':completion:*' completer _extensions _complete _approximate

# Allow to select in a menu.
zstyle ':completion:*' menu select

# one wrong character every X characters is corrected.
# X = 5 is a reasonable default.
zstyle -e ':completion:*:approximate:*' max-errors 'reply=( $(( ($#PREFIX + $#SUFFIX) / 5 )) )'

# Autocomplete options for cd instead of directory stack.
zstyle ':completion:*' complete-options true

zstyle ':completion:*' file-sort modification

# Format output.
zstyle ':completion:*:*:*:*:corrections' format '%F{yellow}!- %d (errors: %e) -!%f'
zstyle ':completion:*:*:*:*:descriptions' format '%F{blue}-- %D %d --%f'
zstyle ':completion:*:*:*:*:messages' format ' %F{purple} -- %d --%f'
zstyle ':completion:*:*:*:*:warnings' format ' %F{red}-- no matches found --%f'

# Colors for files and directory.
zstyle ':completion:*:*:*:*:default' list-colors ${(s.:.)LS_COLORS}

# Only display some tags for the command cd.
zstyle ':completion:*:*:cd:*' tag-order local-directories directory-stack path-directories

# Required for completion to be in good groups (named after the tags).
zstyle ':completion:*' group-name ''
zstyle ':completion:*:*:-command-:*:*' group-order aliases builtins functions commands

# Case insensitive matching.
zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'

zstyle ':completion:*' keep-prefix true

# Also enable autocompletion in sudo mode.
zstyle ":completion::complete:*" gain-privileges 1

# Enable command and folder completion when line is empty.
blanktab() { [[ $#BUFFER == 0 ]] && CURSOR=3 zle list-choices || zle expand-or-complete }
zle -N blanktab && bindkey "^I" blanktab

###################
# PROMPT SETTINGS #
###################

# Git integration.
autoload -Uz vcs_info
precmd_vcs_info() { vcs_info }
precmd_functions+=( precmd_vcd_info )
setopt prompt_subst
PROMPT='%F{red}%n@%m:%F{cyan}%2~%f${vcs_info_msg_0_}%# '
zstyle ':vcs_info:*' check-for-changes true
zstyle ':vcs_info:*' unstagedstr ' *'
zstyle ':vcs_info:*' stagedstr ' +'
zstyle ':vcs_info:git:*' formats '(%b%u%c)'
zstyle ':vcs_info:git:*' actionformats '(%b|%a%u%c)'

# Change cursor shape for different vi modes.
function zle-keymap-select {
    if [[ ${KEYMAP} == vicmd ]] ||
    [[ $1 = "block" ]]; then
        echo -ne "\e[1 q"
    elif [[ ${KEYMAP} == main ]] ||
    [[ ${KEYMAP} == viins ]] ||
    [[ ${KEYMAP} = "" ]] ||
    [[ $1 = "beam" ]]; then
        echo -ne "\e[5 q"
    fi
}

zle -N zle-keymap-select
zle-line-init() {
    zle -K viins # initiate `vi insert` as keymap (can be removed if `bindkey -V` has been set elsewhere)
    echo -ne "\e[5 q"
}
zle -N zle-line-init
echo -ne "\e[5 q" # Use beam shape cursor on startup.
preexec() { echo -ne "\e[5 q" ;} # Use beam shape cursor for each new prompt.

###############
# KEYBINDINGS #
###############

# Shift-tab to browse completion menu backwards.
bindkey -M menuselect '^[[Z' reverse-menu-complete

# Use vim keys in tab complete menu.
bindkey -M menuselect "h" vi-backward-char
bindkey -M menuselect "j" vi-down-line-or-history
bindkey -M menuselect "k" vi-up-line-or-history
bindkey -M menuselect "l" vi-forward-char

bindkey -v "^?" backward-delete-char

bindkey -M menuselect '^xi' vi-insert  # Insert
bindkey -M menuselect '^xu' undo       # Undo

# Fix broken keys.
# Insert.
bindkey "^[[2~" yank
# Delete.
bindkey "^[[3~" delete-char
# PageUp.
bindkey "^[[5~" up-line-or-history
# PageDown.
bindkey "^[[6~" down-line-or-history
# Pos1.
bindkey "^[[7~" beginning-of-line
# End.
bindkey "^[[8~" end-of-line

# Same for command mode.
# Insert.
bindkey -a "^[[2~" yank
# Delete.
bindkey -a "^[[3~" delete-char
# PageUp.
bindkey -a "^[[5~" up-line-or-history
# PageDown.
bindkey -a "^[[6~" down-line-or-history
# Pos1.
bindkey -a "^[[7~" beginning-of-line
# End.
bindkey -a "^[[8~" end-of-line

###########
# ALIASES #
###########

# Neovim is the new vim.
# alias vim="nvim"

# Confirm before overwriting something
alias cp="cp -i"
alias mv="mv -i"
alias rm="rm -i"

# Make managing dotfiles with git easier.
alias dotfiles="/usr/bin/git --git-dir=$HOME/.dotfiles/ --work-tree=$HOME"

# Make "ls" print directories first and ignore colorcode if output to file.
# alias ls="ls -hNF --color=auto --group-directories-first"

# Show hidden files.
# alias la="ls -ahNF --color=auto --group-directories-first"

# Show hidden files and detailed information.
# alias ll="ls -lahNF --color=auto --group-directories-first"

# Use lsd instead of ls.
# Print directories first.
alias "ls"="lsd -h --group-dirs first"

# Show hidden files.
alias "la"="lsd -hA --group-dirs first"

# Show hidden files and detailed information.
alias "ll"="lsd -hlA --group-dirs first"

# Make pacman colorful.
alias pacman="sudo pacman --color=auto"

# Make trizen colorful.
alias trizen="trizen --color=auto"

# Make grep highlight matches.
alias grep="grep --color=auto"

# Remove orphan packages.
alias remorph="pacman -Qtdq | pacman -Rns -"

# Xrandr.
alias xr1920x1080="xrandr --output HDMI-0 --mode 1920x1080"

alias xr1280x960="xrandr --output HDMI-0 --mode 1280x960"

alias xr1024x768="xrandr --output HDMI-0 --mode 1024x768"

alias xr800x600="xrandr --output HDMI-0 --mode 800x600"

alias xr640x480="xrandr --output HDMI-0 --mode 640x480"

# Webcam software 1.
alias webcam1="qv4l2"

# Webcam software 2.
alias webcam2="guvcview"

# Uni vpn tunnel.
alias univpn="univpn.sh"

# Renew.
alias renew="cd $HOME/UNI/MASTER/2-SoSe22/MVS/MVS2022/workspace/Renew/; java -p dist:dist/libs -m de.renew.loader gui"

# Renew Mulan.
alias renewmulan="cd $HOME/UNI/MASTER/2-SoSe22/MVS/MVS2022Mulan/workspace/Renew/; java -p dist:dist/libs -m de.renew.loader gui"

# Renew Settler.
alias renewsettler="cd $HOME/UNI/MASTER/2-SoSe22/MVS/MVS2022Settler/workspace/Renew/; java -p dist:dist/libs -m de.renew.loader gui"

# Renew WebChat.
alias renewwebchat="cd $HOME/UNI/MASTER/2-SoSe22/MVS/MVS2022Mulan/workspace/lehre-ss22-mvs-uebungen/WebChat; bash testing/start.sh"

# Renew WebChat.
alias renewwebchatdc="cd $HOME/UNI/MASTER/2-SoSe22/MVS/MVS2022Mulan/workspace/lehre-ss22-mvs-uebungen/WebChatDC; bash testing/start.sh"

alias makestub="$HOME/UNI/MASTER/2-SoSe22/MVS/MVS2022/workspace/Renew/Core/bin/unix/makestub"

alias compilestub="$HOME/UNI/MASTER/2-SoSe22/MVS/MVS2022/workspace/Renew/Core/bin/unix/compilestub"

alias jcompile="$HOME/UNI/MASTER/2-SoSe22/MVS/MVS2022/workspace/Renew/Core/bin/unix/jcompile"

# Main wine prefix.
alias wine-64="WINEPREFIX=$HOME/.wine64"

# Path to wine games dir.
alias winegames="cd $HOME/.wine/drive_c/Program\ Files\ \(x86\)"

# Reason 4.
alias reason4="sudo mount $HOME/ISOS/Propellerheads.Reason.v4.0.HYBRID.DVDR-AiRISO/Reason4ISO/Reason\ 4.iso /mnt/disk -o loop; cd $HOME/.wine64/drive_c/Program\ Files\ \(x86\)/Propellerhead/Reason/; wine-64 WINEDEBUG=-all wine Reason.exe"

# Baldurs Gate 2.
alias baldur2="cd $HOME/.wine64/drive_c/Program\ Files\ \(x86\)/Baldur\ s\ Gate\ II\ Enhanced\ Edition\ v2\ 5; wine-64 WINEDEBUG=-all wine Baldur.exe"

# Fallout 2.
alias fallout2="cd $HOME/.wine64/drive_c/GOG\ Games/Fallout\ 2/; wine-64 WINEDEBUG=-all WINEDLLOVERRIDES="ddraw.dll=n,b ddraw.ini=n,b" wine fallout2.exe"

# Close Combat 3.
alias cc3="cd $HOME/.wine64/drive_c/GOG\ Games/Close\ Combat\ 3; wine-64 WINEDEBUG=-all wine CC3.exe"

# Warthunder.
