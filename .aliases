# Confirm before overwriting something.
alias cp="cp -i"
alias mv="mv -i"
alias rm="rm -i"

# Manage dotfiles with git.
alias dotfiles="/usr/bin/git --git-dir=$HOME/.dotfiles/ --work-tree=$HOME"

# Use lsd instead of ls with specific options.
alias ls="lsd -h --group-dirs first"
alias la="lsd -hA --group-dirs first"
alias ll="lsd -hlA --group-dirs first"

# Make pacman and trizen colorful.
alias pacman="sudo pacman --color=auto"
alias trizen="trizen --color=auto"

# Make grep highlight matches.
alias grep="grep --color=auto"

# Remove orphan packages.
alias remorph="pacman -Qtdq | pacman -Rns -"

# Xrandr settings for different resolutions.
alias xr1920x1080="xrandr --output HDMI-0 --mode 1920x1080"
alias xr1280x960="xrandr --output HDMI-0 --mode 1280x960"
alias xr1024x768="xrandr --output HDMI-0 --mode 1024x768"
alias xr800x600="xrandr --output HDMI-0 --mode 800x600"
alias xr640x480="xrandr --output HDMI-0 --mode 640x480"

# Webcam software aliases.
alias webcam1="qv4l2"
alias webcam2="guvcview"

# Renew project commands.
renew_command() {
    cd "$1" || return
    java -p dist:dist/libs -m de.renew.loader gui
}

alias renewmaks="renew_command $HOME/UNI/MASTER/3-WiSe2223/MAKS/renew2.6dev-maks-newUI-lin64/renew2.6dev/"
alias renewmulan="renew_command $HOME/UNI/MASTER/2-SoSe22/MVS/MVS2022Mulan/workspace/Renew/"
alias renewsettler="renew_command $HOME/UNI/MASTER/2-SoSe22/MVS/MVS2022Settler/workspace/Renew/"
alias renewwebchat="cd $HOME/UNI/MASTER/2-SoSe22/MVS/MVS2022Mulan/workspace/lehre-ss22-mvs-uebungen/WebChat; bash testing/start.sh"
alias renewwebchatdc="cd $HOME/UNI/MASTER/2-SoSe22/MVS/MVS2022Mulan/workspace/lehre-ss22-mvs-uebungen/WebChatDC; bash testing/start.sh"

# Stub commands.
alias makestub="$HOME/UNI/MASTER/2-SoSe22/MVS/MVS2022/workspace/Renew/Core/bin/unix/makestub"
alias compilestub="$HOME/UNI/MASTER/2-SoSe22/MVS/MVS2022/workspace/Renew/Core/bin/unix/compilestub"
alias jcompile="$HOME/UNI/MASTER/2-SoSe22/MVS/MVS2022/workspace/Renew/Core/bin/unix/jcompile"

# Set Wine prefixes
set_wine_prefix() {
    local prefix="$1"
    export WINEPREFIX="$HOME/.wine$prefix"
    export WINEDEBUG="-all"
}

# Change directory to Wine games directory
cd_wine_games() {
    local prefix="$1"
    cd "$HOME/.wine$prefix/drive_c/Program Files (x86)" || return
}

# Launch Windows software using Wine.
launch_wine() {
    local game_dir="$1"
    local game_executable="$2"
    cd "$game_dir" || return
    wine "$game_executable"
}

# Aliases for Wine prefixes
alias wine-64="set_wine_prefix 64"
alias wine-32="set_wine_prefix 32"

# Aliases for changing to Wine games directories
alias winegames="cd_wine_games ''"
alias winegames64="cd_wine_games 64"
alias winegames32="cd_wine_games 32"

# Launch commands using the launch_wine function.
alias reason4="sudo mount $HOME/ISOS/Propellerheads.Reason.v4.0.HYBRID.DVDR-AiRISO/Reason4ISO/Reason\ 4.iso /mnt/disk; launch_wine '$HOME/.wine64/drive_c/Program Files (x86)/Propellerhead/Reason/' Reason.exe"

