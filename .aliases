# Distant Worlds Universe command with specific settings for wine.
dwu() {
    cd "$HOME/.winedwu"/drive_c/GOG Games/Distant Worlds Universe || return
    WINEARCH=win32 WINEPREFIX="$HOME/.winedwu" WINEDEBUG=-all wine DistantWorlds.exe
}

# Songs of Syx command.
alias sos="launch_wine '$HOME/.wine64/drive_c/GOG Games/Songs of Syx' SongsofSyx.exe"
