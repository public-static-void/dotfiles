[load]
interval=30

[memory]
interval=30

[separator]

# [iface]
# interval=1800

[ping]
interval=30

[separator]

[volume]
interval=once
signal=1

# [brightness]
# interval=once
# signal=2

# [battery]
# interval=1

[separator]

[date]
interval=5

[time]
interval=1

[separator]

[updates]
interval=600
signal=1

[separator]

[key]
BLOCK_LABEL=CAPS
interval=once
