####################
# ~/.config/i3blocks/config
####################

#####################
# GLOBAL PROPERTIES #
#####################

DEFAULT_COLOR=#D4CFC9
OK_COLOR=#9FE8C2
MID_COLOR=#FFFEB3
WARNING_COLOR=#D45769
CRITICAL_COLOR=#FB2E01
command=~/.config/i3blocks/scripts/$BLOCK_NAME/$BLOCK_NAME
markup=pango
separator_block_width=15
full_text=
align=center
color=DEFAULT_COLOR
separator=false

#############
# BLOCKLETS #
#############

[temperature]
interval=10

[load]
interval=30

[separator]

[memory]
interval=30

[separator]

[iface]
interval=1800

[ping]
interval=30

[separator]

[volume]
interval=once
signal=1

[separator]

[date]
interval=5

[time]
interval=1

[separator]

[updates]
interval=600
signal=1

[separator]

[key]
BLOCK_LABEL=CAPS
interval=once
signal=11

[key]
BLOCK_LABEL=NUM
interval=once
signal=11

[separator]
