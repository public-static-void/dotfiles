####################
# ~/.config/i3blocks/config
####################

#####################
# GLOBAL PROPERTIES #
#####################

DEFAULT_COLOR=#d4d4d4
OK_COLOR=#b5cea8
MID_COLOR=#dcdcaa
WARNING_COLOR=#ce9178
CRITICAL_COLOR=#f14c4c
INACTIVE_COLOR=#1e1e1e
command=~/.config/i3blocks/scripts/$BLOCK_NAME/$BLOCK_NAME
markup=pango
separator_block_width=15
full_text=
align=center
color=#d4d4d4
