#!/usr/bin/env bash
# i3blocks volume control script with advanced features
# Supports pactl/pulseaudio, pamixer, and ALSA backends
# Features: device cycling, volume stepping, mute toggle, and automatic locale detection

# ──── Configuration ────
DEFAULT_COLOR="${DEFAULT_COLOR:-#D4CFC9}"
OK_COLOR="${OK_COLOR:-#9FE8C2}"
MID_COLOR="${MID_COLOR:-#FFFEB3}"
WARNING_COLOR="${WARNING_COLOR:-#D45769}"
CRITICAL_COLOR="${CRITICAL_COLOR:-#FB2E01}"
MUTED_COLOR="${INACTIVE_COLOR:-#1e1e1e}"

AUDIO_HIGH_SYMBOL="󰕾"
AUDIO_MID_SYMBOL="󰖀"
AUDIO_LOW_SYMBOL="󰕿"
AUDIO_MUTED_SYMBOL="󰝟"
AUDIO_DELTA=5

# Persistent state storage
STATE_FILE="${HOME}/.i3audio.state"

# Initialize state directory
mkdir -p "$(dirname "$STATE_FILE")"
touch "$STATE_FILE"

# ──── Function Library ────

function init_backend {
	# Detects available audio backend in order of preference:
	# 1. pamixer
	# 2. pactl (PulseAudio)
	# 3. ALSA
	# Sets global AUDIO_BACKEND variable
	if command -v pamixer &>/dev/null; then
		AUDIO_BACKEND="pamixer"
	elif command -v pactl &>/dev/null; then
		AUDIO_BACKEND="pactl"
	elif command -v amixer &>/dev/null; then
		AUDIO_BACKEND="alsa"
		ALSA_CONTROL=$(amixer scontrols 2>/dev/null | awk -F"'" '/Simple mixer control/{print $2; exit}' || echo "Master")
	else
		exit 1
	fi
}

function shorten_name {
	# Simplifies audio device names for display
	# Arguments:
	#   $1 - Raw device name string
	# Returns:
	#   Shortened name (e.g., "PCM2902" from "PCM2902 Audio Codec")
	local name="${1:-}"
	[[ -z "$name" ]] && echo "Audio" && return

	name=$(echo "$name" | sed -E '
        s/ (Audio|Codec|Controller|Device)//Ig;
        s/[()]//g;
        s/[_-]/ /g;
        s/\b(USB|HDA|AC97|IEC958|S\/PDIF|Surround|Duplex)\b//Ig;
        s/\s+/ /g;
        s/^\s*|\s*$//g;
    ')

	[[ "$name" =~ (PCM[0-9]+|CS[0-9]+|ALC[0-9]+|TU[0-9]+) ]] && echo "${BASH_REMATCH[1]}" || echo "${name:-Audio}"
}

function get_volume {
	# Retrieves current volume and mute status
	# Returns:
	#   Two values: volume_percentage mute_state
	#   mute_state: "true" or "false"
	case "$AUDIO_BACKEND" in
	pamixer)
		volume=$(pamixer --get-volume 2>/dev/null)
		muted=$(pamixer --get-mute 2>/dev/null)
		;;
	pactl)
		sink=$(pactl get-default-sink 2>/dev/null)
		volume=$(pactl list sinks 2>/dev/null | awk -v sink="$sink" '
            /Name:/ {current_sink=$2}
            /Volume:/ && current_sink == sink {
                if (/Lautstärke:/) { gsub(/%/, "", $3); print $3 }
                else { gsub(/%/, "", $5); print $5 }
                exit
            }')
		muted=$(pactl list sinks 2>/dev/null | awk -v sink="$sink" '
            /Name:/ {current_sink=$2}
            /Mute:/ && current_sink == sink { print $2; exit }
            /Stumm:/ && current_sink == sink { print $2; exit }')
		[[ "$muted" == "yes" || "$muted" == "ja" ]] && muted=true || muted=false
		;;
	alsa)
		control="${ALSA_CONTROL:-Master}"
		raw_output=$(amixer get "$control" 2>&1)
		volume=$(echo "$raw_output" | awk -F'[][]' '/%/ {print $2; exit}' | tr -d '%')
		muted=$(echo "$raw_output" | grep -q '\[off\]' && echo true || echo false)
		;;
	esac

	# Validation and fallback
	[[ "$volume" =~ ^[0-9]+$ ]] || {
		[[ "$AUDIO_BACKEND" == "pactl" ]] &&
			volume=$(pactl list sinks | awk -v sink="$sink" '
            /Name:/ {current_sink=$2}
            /Lautstärke:/ && current_sink == sink {
                match($0, /[0-9]+%/)
                pct=substr($0, RSTART, RLENGTH)
                gsub(/%/, "", pct)
                print pct
                exit
            }')
		[[ "$volume" =~ ^[0-9]+$ ]] || volume=0
	}

	echo "$volume $muted"
}

function get_device_name {
	# Retrieves current audio device name
	# Returns:
	#   Full device name string
	case "$AUDIO_BACKEND" in
	pamixer | pactl)
		sink=$(pactl get-default-sink 2>/dev/null)
		pactl_output=$(pactl list sinks 2>/dev/null)
		name=$(echo "$pactl_output" | awk -v sink="$sink" '
            /Name:/ {current_sink=$2}
            /device.product.name/ && current_sink == sink {
                desc=substr($0, index($0,$3))
                gsub(/["\r]/, "", desc)
                print desc
                exit
            }
            /Beschreibung:/ && current_sink == sink {
                desc=substr($0, index($0,$2))
                sub(/^Built-in /, "", desc)
                sub(/^Headset /, "", desc)
                print desc
                exit
            }
            /Description:/ && current_sink == sink {
                desc=substr($0, index($0,$2))
                sub(/^Built-in /, "", desc)
                sub(/^Headset /, "", desc)
                print desc
                exit
            }')
		;;
	alsa)
		card="${ALSA_CARD:-0}"
		name=$(amixer -c "$card" info 2>&1 | awk -F"'" '/Simple mixer control/{print $2; exit}')
		;;
	esac

	echo "${name:-Unknown Device}"
}

function handle_click {
	# Handles mouse click events from i3blocks
	# Supported actions:
	#   Left-click: Cycle audio devices
	#   Right-click: Toggle mute
	#   Scroll-up: Increase volume
	#   Scroll-down: Decrease volume
	case "$BLOCK_BUTTON" in
	1) # Device cycling
		if [[ "$AUDIO_BACKEND" == @(pamixer|pactl) ]]; then
			mapfile -t sinks < <(pactl list short sinks 2>/dev/null | awk '{print $2}')
			current=$(pactl get-default-sink 2>/dev/null)
			index=$(printf '%s\n' "${sinks[@]}" | awk -v cur="$current" '{if ($1==cur) print NR-1}')
			next=$(((index + 1) % ${#sinks[@]}))
			pactl set-default-sink "${sinks[$next]}" 2>/dev/null &&
				pactl list short sink-inputs 2>/dev/null | awk '{print $1}' | xargs -r -I{} pactl move-sink-input {} "${sinks[$next]}" 2>/dev/null
		else
			readarray -t cards < <(aplay -l 2>/dev/null | awk -F: '/^card/ {print $1}' | awk '{print $2}' | sort -u)
			current_index=$(grep '^alsa_index=' "$STATE_FILE" 2>/dev/null | cut -d= -f2 || echo 0)
			next=$(((current_index + 1) % ${#cards[@]}))
			export ALSA_CARD="${cards[$next]}"
			echo alsa_index=$next >"$STATE_FILE"
		fi
		;;
	3) # Mute toggle
		case "$AUDIO_BACKEND" in
		pamixer) pamixer --toggle-mute 2>/dev/null ;;
		pactl) pactl set-sink-mute @DEFAULT_SINK@ toggle 2>/dev/null ;;
		alsa) amixer -q set "${ALSA_CONTROL:-Master}" toggle 2>/dev/null ;;
		esac
		;;
	4) # Volume up
		case "$AUDIO_BACKEND" in
		pamixer) pamixer -i "$AUDIO_DELTA" --allow-boost 2>/dev/null ;;
		pactl) pactl set-sink-volume @DEFAULT_SINK@ +"$AUDIO_DELTA%" 2>/dev/null ;;
		alsa) amixer -q set "${ALSA_CONTROL:-Master}" "${AUDIO_DELTA}%+" 2>/dev/null ;;
		esac
		;;
	5) # Volume down
		case "$AUDIO_BACKEND" in
		pamixer) pamixer -d "$AUDIO_DELTA" 2>/dev/null ;;
		pactl) pactl set-sink-volume @DEFAULT_SINK@ -"$AUDIO_DELTA%" 2>/dev/null ;;
		alsa) amixer -q set "${ALSA_CONTROL:-Master}" "${AUDIO_DELTA}%-" 2>/dev/null ;;
		esac
		;;
	esac
	pkill -RTMIN+10 i3blocks 2>/dev/null
}

# ──── Main Execution ────
function main {
	# Primary control flow
	init_backend
	[[ -n "${BLOCK_BUTTON:-}" ]] && handle_click

	read -r volume muted <<<"$(get_volume)"
	device_name=$(get_device_name)
	short_name=$(shorten_name "$device_name")

	# Volume validation
	[[ "$volume" =~ ^[0-9]+$ ]] || volume=0
	[[ "$muted" == "true" ]] || muted=false

	# Display logic
	if $muted; then
		symbol="$AUDIO_MUTED_SYMBOL"
		color="$MUTED_COLOR"
	elif ((volume >= 90)); then
		symbol="$AUDIO_HIGH_SYMBOL"
		color="$CRITICAL_COLOR"
	elif ((volume >= 75)); then
		symbol="$AUDIO_HIGH_SYMBOL"
		color="$WARNING_COLOR"
	elif ((volume >= 50)); then
		symbol="$AUDIO_MID_SYMBOL"
		color="$MID_COLOR"
	elif ((volume >= 25)); then
		symbol="$AUDIO_MID_SYMBOL"
		color="$OK_COLOR"
	else
		symbol="$AUDIO_LOW_SYMBOL"
		color="$OK_COLOR"
	fi

	# Final output formatting
	echo "<span color='${DEFAULT_COLOR}'>$symbol</span> \
<span color='${color}'>${volume}%</span> \
<span color='${DEFAULT_COLOR}'>(${short_name})</span>"
}

# Execute main function
main "$@"
