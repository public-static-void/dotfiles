#######################
# ~/.config/i3/config #
#######################

####################
# GENERAL SETTINGS #
####################

# Set mod key.
set $mod Mod4

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:sourcecodepro 13

#############
# AUTOSTART #
#############

# Start compositor.
exec_always picom -f

# Use nitrogen to set wallpaper.
exec_always --no-startup-id nitrogen --restore &

# Use wal to set wallpaper and extract colors from it.
# exec_always --no-startup-id wal -i "$HOME/Bilder/walls/aesthetic2.jpg" -a 75 --backend haishoku
# Use wal just to load last color scheme.
#exec_always --no-startup-id wal -Rq

# Start dunst notification tool.
exec --no-startup-id dunst

# Dynamically changes the names of workspaces depending on what windows are open in them.
# Names of applications and keywords are replaced with icons from FontAwesome.
exec_always --no-startup-id exec i3-workspace-names-daemon

##############
# WORKSPACES #
##############

# Configure workspaces according to i3-workspace-names-daemon conventions.
# Set workspace variables.
set $workspace1 "1: "
set $workspace2 "2: "
set $workspace3 "3: "
set $workspace4 "4: "
set $workspace5 "5: "
set $workspace6 "6: "
set $workspace7 "7: "
set $workspace8 "8: "
set $workspace9 "9: "
set $workspace10 "10:"

###########
# WINDOWS #
###########

# Use Mouse+$mod to drag floating windows to their wanted position.
floating_modifier $mod

# Don't change window focus by mouse hovering.
focus_follows_mouse no

# Set colors from Xresources.
# At the end of each line fallback colors are specified in case it fails.

# Focused.
set_from_resource $bdf  i3wm.color7 #9FE8C2
set_from_resource $bgf  i3wm.color7 #4CB88F
set_from_resource $fgf  i3wm.color8 #E7E4D8
# Unfocused.
set_from_resource $bdu  i3wm.color8 #308695
set_from_resource $bgu  i3wm.color8 #455054 #
set_from_resource $fgu  i3wm.color15 #D4CFC9
# Inactive.
set_from_resource $bdi  i3wm.color8 #308695
set_from_resource $bgi  i3wm.color8 #656262
set_from_resource $fgi  i3wm.color7 #4CB88F
# Urgent.
set_from_resource $bdx  i3wm.color1 #D45769
set_from_resource $bgx  i3wm.color9 #FB2E01
set_from_resource $fgx  i3wm.color11 #FFFEB3

#set_from_resource $term_background background
#set_from_resource $term_foreground foreground
#set_from_resource $term_color0     color0
#set_from_resource $term_color1     color1
#set_from_resource $term_color2     color2
#set_from_resource $term_color3     color3
#set_from_resource $term_color4     color4
#set_from_resource $term_color5     color5
#set_from_resource $term_color6     color6
#set_from_resource $term_color7     color7
#set_from_resource $term_color8     color8
#set_from_resource $term_color9     color9
#set_from_resource $term_color10    color10
#set_from_resource $term_color11    color11
#set_from_resource $term_color12    color12
#set_from_resource $term_color13    color13
#set_from_resource $term_color14    color14
#set_from_resource $term_color15    color15


client.background       $bgu

# class                 border  backgr. text  indicator child_border
client.focused          $bdf    $bgf    $fgf  $bgf      $bgf
client.unfocused        $bdu    $bgu    $fgu  $bgu      $bgu
client.focused_inactive $bdi    $bgi    $fgi  $bgi      $bgi
client.urgent           $bdx    $bgx    $fgx  $bgx      $bgx
client.placeholder      $bdf    $bgf    $fgf  $bgf      $bgf

###############
# BAR / PANEL #
###############

# Start i3bar to display a workspace bar (plus the system information i3status
# finds out, if available).
bar {
        status_command i3blocks
        tray_output primary

        colors {
                background          $bgu
                separator           $fgu
                # class             border  backgr. text
                focused_workspace   $bdf    $bgf    $fgf
                inactive_workspace  $bdi    $bgi    $fgi
                urgent_workspace    $bdx    $bgx    $fgx
        }
}

###############
# KEYBINDINGS #
###############

# Bind keys to switch workspaces.
bindsym $mod+1 workspace number $workspace1
bindsym $mod+2 workspace number $workspace2
bindsym $mod+3 workspace number $workspace3
bindsym $mod+4 workspace number $workspace4
bindsym $mod+5 workspace number $workspace5
bindsym $mod+6 workspace number $workspace6
bindsym $mod+7 workspace number $workspace7
bindsym $mod+8 workspace number $workspace8
bindsym $mod+9 workspace number $workspace9
bindsym $mod+0 workspace number $workspace10

# Bind keys to move containers between workspaces.
bindsym $mod+Shift+1 move container to workspace number $workspace1
bindsym $mod+Shift+2 move container to workspace number $workspace2
bindsym $mod+Shift+3 move container to workspace number $workspace3
bindsym $mod+Shift+4 move container to workspace number $workspace4
bindsym $mod+Shift+5 move container to workspace number $workspace5
bindsym $mod+Shift+6 move container to workspace number $workspace6
bindsym $mod+Shift+7 move container to workspace number $workspace7
bindsym $mod+Shift+8 move container to workspace number $workspace8
bindsym $mod+Shift+9 move container to workspace number $workspace9
bindsym $mod+Shift+0 move container to workspace number $workspace10

# Define keys ro resize windows (you can also use the mouse for that).
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode.

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        # Same bindings, but for the arrow keys.
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # Back to normal: Enter or Escape or $mod+r.
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

# Enable window resize mode.
bindsym $mod+r mode "resize"

# Start firefox.
bindsym $mod+Shift+f exec --no-startup-id firefox

# Open i3 config.
bindsym $mod+Shift+a exec --no-startup-id urxvt -e vim ~/.config/i3/config

# Open i3blocks config.
bindsym $mod+Shift+y exec --no-startup-id urxvt -e vim ~/.i3blocks.conf

# Open Xdefaults.
bindsym $mod+Shift+x exec --no-startup-id urxvt -e vim ~/.Xdefaults

# Open bashrc.
#bindsym $mod+Shift+s exec --no-startup-id urxvt -e vim ~/.bashrc

# Open zshrc.
bindsym $mod+Shift+s exec --no-startup-id urxvt -e vim ~/.zshrc

# Open vimrc.
bindsym $mod+Shift+d exec --no-startup-id urxvt -e vim ~/.vimrc

# Open picom config.
bindsym $mod+Shift+less exec --no-startup-id urxvt -e vim ~/.config/picom/picom.conf

# Start Spacefm.
bindsym $mod+Shift+w exec --no-startup-id spacefm

# Start htop.
bindsym Ctrl+Mod1+Delete exec --no-startup-id urxvt -e htop

# Make screenshot.
bindsym Print exec scrot '%Y-%m-%d-%s_screenshot_$wx$h.jpg' -e 'mv $f ~/Bilder/'

# For i3blocks visualization of capslock etc. button pressed.
# CAPS.
bindsym --release Caps_Lock exec pkill -SIGRTMIN+11 i3blocks
# NUM.
bindsym --release Num_Lock exec pkill -SIGRTMIN+11 i3blocks

# Start a terminal.
bindsym $mod+Return exec i3-sensible-terminal

# Kill focused window.
bindsym $mod+Shift+q kill

# Start dmenu.
bindsym $mod+d exec dmenu_run -nb "$bgf" -nf "$fgf" -sb "$bgx" -sf "$fgx" -fn "SourceCodePro-13"
# Shutdown computer with prompt script.
bindsym $mod+Shift+Escape exec ~/scripts/prompt "Rechner runterfahren?" "sudo -A shutdown -h now" "$bgf" "$fgf" "$bgx" "$fgx" "SourceCodePro-13"

