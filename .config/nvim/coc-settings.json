{
  // General settings.
  // Define filetypes to format on save.
  "coc.preferences.formatOnSaveFiletypes": [
    "html",
    "css",
    "javascript",
    "python",
    "java",
    "json",
    "jsonc"
  ],

  // Trigger completion list manually.
  "suggest.autoTrigger": "none",

  "suggest.defaultSortMethod": "alphabetical",

  // Language Serverssetup.

  // Java.
  // Download following archive: //https://download.eclipse.org/jdtls/milestones/0.57.0/jdt-language-server-0.57.0-202006172108.tar.gz
  // and replace $HOME/.config/coc/extensions/coc-java-data/server/
  // with its content.

  // Python.
  // Pyright config.
  "pyright.enable": true,
  "python.analysis.autoImportCompletions": true,
  "python.formatting.provider": "autopep8",
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": true,
  "python.linting.pydocstyleEnabled": true,
  "python.linting.flake8Enabled": true,
  "pyright.completion.importSupport": true,
  // Pydoctring config.
  "pydocstring.formatter": "numpy"
}
