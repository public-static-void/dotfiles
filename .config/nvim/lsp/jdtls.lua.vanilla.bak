local utils = require("user.utils")

local handlers = utils.safe_require("user.lsp.handlers")
if not handlers then
	vim.notify("[JDTLS] Failed to load user.lsp.handlers, aborting LSP setup", vim.log.levels.ERROR)
	return
end

local mason_path = vim.fn.stdpath("data") .. "/mason/packages"
local root_dir = vim.fs.root(0, { ".git", "mvnw", "gradlew", "pom.xml", "build.gradle" })
if not root_dir then
	vim.notify("[JDTLS] Could not find root directory, aborting LSP setup", vim.log.levels.ERROR)
	return
end

local project_name = vim.fn.fnamemodify(root_dir, ":p:h:t")
local workspace_dir = vim.fn.expand("~") .. "/workspace/" .. project_name

if not workspace_dir or workspace_dir == "" then
	vim.notify("[JDTLS] Workspace directory not set, check your config", vim.log.levels.WARN)
end

local bundles = utils.find_bundles({
	mason_path .. "/java-debug-adapter/extension/server/com.microsoft.java.debug.plugin-*.jar",
	mason_path .. "/java-test/extension/server/com.microsoft.java.test.plugin-*.jar",
})

if not bundles or vim.tbl_isempty(bundles) then
	vim.notify(
		"[JDTLS] Warning: No debug/test bundles found. Debugging and test features will be limited.",
		vim.log.levels.WARN
	)
else
	vim.notify("[JDTLS] Found debug/test bundles: " .. table.concat(bundles, ", "), vim.log.levels.INFO)
end

local launcher_jar = vim.fn.glob(mason_path .. "/jdtls/plugins/org.eclipse.equinox.launcher_*.jar")
if launcher_jar == "" then
	vim.notify(
		"[JDTLS] Launcher JAR not found in " .. mason_path .. "/jdtls/plugins. Check your mason installation.",
		vim.log.levels.ERROR
	)
	return
end

local config_dir = mason_path
	.. "/jdtls/config_"
	.. (vim.fn.has("win32") == 1 and "win" or (vim.fn.has("macunix") == 1 and "mac" or "linux"))

local extendedClientCapabilities = {
	resolveAdditionalTextEditsSupport = true,
	progressReportProvider = true,
	inlayHints = { parameterNames = { enabled = "all" } },
	onCompletionItemSelectedCommand = "editor.action.triggerParameterHints",
}

vim.notify("[JDTLS] Starting language server with extended capabilities.", vim.log.levels.INFO)

return {
	on_attach = function(client, bufnr)
		vim.notify("[JDTLS] LSP attached to buffer " .. bufnr, vim.log.levels.INFO)
		handlers.on_attach(client, bufnr)
	end,
	capabilities = handlers.capabilities,
	cmd = {
		"java",
		"-Declipse.application=org.eclipse.jdt.ls.core.id1",
		"-Dosgi.bundles.defaultStartLevel=4",
		"-Declipse.product=org.eclipse.jdt.ls.core.product",
		"-Dlog.protocol=true",
		"-Dlog.level=ALL",
		"-Xmx1g",
		"--add-modules=ALL-SYSTEM",
		"--add-opens",
		"java.base/java.util=ALL-UNNAMED",
		"--add-opens",
		"java.base/java.lang=ALL-UNNAMED",
		"-jar",
		launcher_jar,
		"-configuration",
		config_dir,
		"-data",
		workspace_dir,
	},
	root_dir = root_dir,
	filetypes = { "java" },
	settings = {
		java = {
			eclipse = { downloadSources = true },
			configuration = { updateBuildConfiguration = "interactive" },
			maven = { downloadSources = true },
			implementationsCodeLens = { enabled = true },
			referencesCodeLens = { enabled = true },
			references = { includeDecompiledSources = true },
			format = { enabled = false },
			signatureHelp = { enabled = true },
			completion = {
				favoriteStaticMembers = {
					"org.hamcrest.MatcherAssert.assertThat",
					"org.hamcrest.Matchers.*",
					"org.hamcrest.CoreMatchers.*",
					"org.junit.jupiter.api.Assertions.*",
					"java.util.Objects.requireNonNull",
					"java.util.Objects.requireNonNullElse",
					"org.mockito.Mockito.*",
				},
			},
			contentProvider = { preferred = "fernflower" },
			extendedClientCapabilities = extendedClientCapabilities,
			sources = {
				organizeImports = {
					starThreshold = 9999,
					staticStarThreshold = 9999,
				},
			},
			codeGeneration = {
				toString = {
					template = "${object.className}{${member.name()}=${member.value}, ${otherMembers}}",
				},
				useBlocks = true,
			},
		},
	},
	init_options = {
		bundles = bundles,
	},
}
