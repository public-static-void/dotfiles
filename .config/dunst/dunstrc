[global]
### Core Settings ###
monitor = 0
follow = mouse
origin = top-right
offset = 2x26
indicate_hidden = yes
shrink = yes
sort = yes

### Geometry ###
width = 300  # Fixed width recommended
height = 150  # Fixed height recommended
transparency = 10
frame_width = 4
frame_color = "#2f343f"
separator_height = 2
separator_color = frame
padding = 8
horizontal_padding = 8

### Text & Styling ###
font = MesloLGSDZ Nerd Font Mono 13
markup = full
format = "<b>%s</b>\n%b"
alignment = left
word_wrap = yes
ellipsize = middle
show_indicators = yes
line_height = 0

### Icons ###
icon_position = off
max_icon_size = 32
icon_path = /usr/share/icons/hicolor/48x48/status/:/usr/share/icons/hicolor/48x48/devices/

### Behavior ###
stack_duplicates = true
hide_duplicate_count = false
idle_threshold = 120
sticky_history = yes
history_length = 20

### Shortcuts ###
close = ctrl+space
close_all = ctrl+shift+space
context = ctrl+shift+period

### Advanced ###
dmenu = /usr/bin/dmenu -p dunst:
browser = xdg-open  # More universal URL handling
always_run_script = true
force_xinerama = false

[urgency_low]
background = "#505050"
foreground = "#888888"
frame_color = "#2f343f"
timeout = 10

[urgency_normal]
background = "#68aaaa"
foreground = "#ffffff"
frame_color = "#505050"
timeout = 10

[urgency_critical]
background = "#ff0000"
foreground = "#ffffff"
frame_color = "#e53935"
timeout = 0

[experimental]
per_monitor_dpi = false
